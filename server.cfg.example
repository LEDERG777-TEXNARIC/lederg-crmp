echo Executing Server Config...
lanmode 0
hostname LEDERG PROJECT | CR:MP RolePlay
gamemode0 new 1
rcon_password REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
announce 1
query 1
weburl https://github.com/LEDERG777-TEXNARIC/lederg-crmp
maxnpc 0
onfoot_rate 40
incar_rate 40
weapon_rate 40
stream_distance 300.0
stream_rate 1000
maxplayers 100
mapname Criminal Russia
chatlogging 0
# Change port to the UDP port assigned by the hosting control panel.
port 1130
# Use only one MySQL plugin variant. The static build avoids external client-library dependencies.
plugins crashdetect.so mysql_static.so sscanf.so streamer.so iTD.so

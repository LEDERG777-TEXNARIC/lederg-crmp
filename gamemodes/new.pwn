		        if(strval(inputtext) <= 0) return SendClientMessage(playerid, COLOR_WARNING, "Ошибка #504");
				if(strval(inputtext) > get_player_money(playerid)) return SendClientMessage(playerid, COLOR_WARNING,"У Вас недостаточно денег на руках!");
				give_player_money(playerid, -strval(inputtext),"#12");
				POLIT_TEAM[team][data_BANK] += strval(inputtext);
				new query[120];
				format(query, sizeof(query), "UPDATE `polit_team` SET `bank` = '%d' WHERE `id` = '%d'",POLIT_TEAM[team][data_BANK],PLAYER_DATA[playerid][data_POLIT]);
    			mysql_function_query(dbHandle, query, false, "", "");

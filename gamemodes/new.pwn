				SendClientMessageToAll(0x33CC66FF,str1),SendClientMessageToAll(0x339966FF,str2);
				AD_DATA[a][data_STATUS] = 0;
				TotalAD--;
			}
		}
		
		
    	case dialog_OK:
		{
		    if(!response) return true;
		    if(response) return true;
		}
		case dialog_SETSPAWN:
		{
		    if(!response) return true;
		    if(response)
		    {
		        switch(listitem)
		        {
		            case 0:
					{
					    if(PLAYER_DATA[playerid][data_MEMBER] == 0) return SendClientMessage(playerid, COLOR_WARNING, "Вы не состоите во организации!");
                        PLAYER_DATA[playerid][data_SPAWN] = 1;
					    SendClientMessage(playerid, 0x81BEF7AA, "Теперь Вы будете появляться на базе организации");
					}
		            case 1:
					{
					    PLAYER_DATA[playerid][data_SPAWN] = 0;
					    SendClientMessage(playerid, 0x81BEF7AA, "Теперь Вы будете появляться на ЖД Вокзале");
					}
		            case 2:
					{
					    if(PLAYER_DATA[playerid][data_HOUSE] == INVALID_HOUSE_ID && PLAYER_DATA[playerid][data_KV] == INVALID_HOUSE_ID) return SendClientMessage(playerid, COLOR_WARNING, "У Вас нет дома!");
                        PLAYER_DATA[playerid][data_SPAWN] = 2;
					    SendClientMessage(playerid, 0x81BEF7AA, "Теперь Вы будете появляться в доме");
					}
		        }
		    }
		}
	}
	return true;
}


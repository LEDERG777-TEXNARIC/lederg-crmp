		    {
		        new team = GetPlayerPolit(playerid);
		        if(strval(inputtext) <= 0) return SendClientMessage(playerid, COLOR_WARNING, "Ошибка #504");
				if(strval(inputtext) > POLIT_TEAM[team][data_BANK]) return SendClientMessage(playerid, COLOR_WARNING,"На счету партии недостаточно денег!");
				give_player_money(playerid, strval(inputtext),"#13");
				POLIT_TEAM[team][data_BANK] -= strval(inputtext);

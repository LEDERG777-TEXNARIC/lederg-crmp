		case 4:format(str,sizeof(str),"Должность:\t\t\t%s\n",rang_hospital[PLAYER_DATA[playerid][data_RANK]-1][frName]),strcat(sctring,str);
	    case 5,6,7:format(str,sizeof(str),"Масть:\t\t\t\t%s\n",rang_crime[PLAYER_DATA[playerid][data_RANK]-1][frName]),strcat(sctring,str);
        case 8:format(str,sizeof(str),"Звание:\t\t\t%s\n",rang_fsb[PLAYER_DATA[playerid][data_RANK]-1][frName]),strcat(sctring,str);
        case 9:format(str,sizeof(str),"Должность:\t\t\t%s\n",rang_smi[PLAYER_DATA[playerid][data_RANK]-1][frName]),strcat(sctring,str);

CMD:ap(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Вы не авторизованы на сервере!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 1) return true;
    
    if(GetPVarInt(playerid, "ap") == 0)
    {
        SetPVarInt(playerid, "ap", 1);
        for(new i = 0; i < 9; i++) TextDrawHideForPlayer(playerid, CheatText[i]);
    }
    else
    {
        SetPVarInt(playerid, "ap", 0);
        for(new i = 0; i < 9; i++) TextDrawShowForPlayer(playerid, CheatText[i]);
    }

	return true;
}




CMD:pirathelp(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");

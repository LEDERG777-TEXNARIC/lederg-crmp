}

CMD:remont(playerid, params[])
     {
		if(!IsPlayerInAnyVehicle(playerid))
		{
			SendClientMessage(playerid, COLOR_GRAD1, " Нужно быть в автомобиле.");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,7.0,337.3224,489.5129,12.0143) ||IsPlayerInRangeOfPoint(playerid,7.0,-342.4479,373.4171,12.3660)||IsPlayerInRangeOfPoint(playerid,7.0,2150.8242,-1852.3241,18.4441)||IsPlayerInRangeOfPoint(playerid,7.0,2382.8313,-779.6200,11.9490)||IsPlayerInRangeOfPoint(playerid,7.0,-714.4241,1955.4580,45.6151))  //IZ UZHNOOGO
		{
    	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, PlayerIsNotInCar);
    	RepairVehicle(GetPlayerVehicleID(playerid));
    	SendClientMessage(playerid, COLOR_WHITE, "Ваш транспорт отремонтирован за 4000 руб.");
		give_player_money(playerid, -4000,"#100");
		}
		else
		{
			SendClientMessage(playerid,-1, "Вы далеко от мастерской");
		}
		return 1;
	}


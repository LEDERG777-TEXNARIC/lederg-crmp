			new owner[MAX_PLAYER_NAME], class_kv[8],kk;
			for(new k = 0; k < 6; k++)
			{
				switch(k)
				{
				    case 0: strmid(owner, KV_DATA[kv][data_OWNER_1], 0, strlen(KV_DATA[kv][data_OWNER_1]), MAX_PLAYER_NAME);
				    case 1: strmid(owner, KV_DATA[kv][data_OWNER_2], 0, strlen(KV_DATA[kv][data_OWNER_2]), MAX_PLAYER_NAME);
				    case 2: strmid(owner, KV_DATA[kv][data_OWNER_3], 0, strlen(KV_DATA[kv][data_OWNER_3]), MAX_PLAYER_NAME);
				    case 3: strmid(owner, KV_DATA[kv][data_OWNER_4], 0, strlen(KV_DATA[kv][data_OWNER_4]), MAX_PLAYER_NAME);
				    case 4: strmid(owner, KV_DATA[kv][data_OWNER_5], 0, strlen(KV_DATA[kv][data_OWNER_5]), MAX_PLAYER_NAME);
				    case 5: strmid(owner, KV_DATA[kv][data_OWNER_6], 0, strlen(KV_DATA[kv][data_OWNER_6]), MAX_PLAYER_NAME);
				}

				switch(KV_DATA[kv][data_CLASS][k])
				{
				    case 0: class_kv = "Эконом";
				    case 1: class_kv = "Средний";
				    case 2: class_kv = "Элитный";
				}

				KV_DATA[kv][data_PICKKV_ENTER][k] = CreateDynamicPickup(1318, 23, KV_DATA[kv][data_ENTER_POSX][k], KV_DATA[kv][data_ENTER_POSY][k], KV_DATA[kv][data_ENTER_POSZ][k], KV_DATA[kv][data_ID]);
				KV_DATA[kv][data_PICKKV_EXIT][k] = CreateDynamicPickup(1318, 23, KV_DATA[kv][data_EXIT_POSX][k], KV_DATA[kv][data_EXIT_POSY][k], KV_DATA[kv][data_EXIT_POSZ][k], KV_DATA[kv][data_ID]+k);

				if(KV_DATA[kv][data_OWNED][k] == 0)
			    {
                    format(str,sizeof(str), "{66FF66}Квартира №%d\n{6699CC}Класс: {FFFFFF}%s\n{6699CC}Стоимость: {FFFFFF}%d рублей\n{FFCC00}Для покупки используйте: /buy",k+1, class_kv, KV_DATA[kv][data_PRICE][k]);
		 	        KV_DATA[kv][data_INFO][k] = CreateDynamic3DTextLabel(str, -1, KV_DATA[kv][data_ENTER_POSX][k], KV_DATA[kv][data_ENTER_POSY][k], KV_DATA[kv][data_ENTER_POSZ][k], 5.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,KV_DATA[kv][data_ID]);
			    }
			    else
			    {
			        kk++;
			        format(str,sizeof(str), "{66FF66}Квартира №%d\n{6699CC}Класс: {FFFFFF}%s\n{6699CC}Владелец: {FFFFFF}%s",k+1, class_kv, owner);
		 	        KV_DATA[kv][data_INFO][k] = CreateDynamic3DTextLabel(str, -1, KV_DATA[kv][data_ENTER_POSX][k], KV_DATA[kv][data_ENTER_POSY][k], KV_DATA[kv][data_ENTER_POSZ][k], 5.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,KV_DATA[kv][data_ID]);
			    }
			}
			if(kk == 6)
			{
			    KV_DATA[kv][data_MAPICON] = CreateDynamicMapIcon(KV_DATA[kv][data_ENTER_X], KV_DATA[kv][data_ENTER_Y], KV_DATA[kv][data_ENTER_Z], 32, -1, 0, -1, -1, 100.0);
			}
			else
			{
			    KV_DATA[kv][data_MAPICON] = CreateDynamicMapIcon(KV_DATA[kv][data_ENTER_X], KV_DATA[kv][data_ENTER_Y], KV_DATA[kv][data_ENTER_Z], 31, -1, 0, -1, -1, 100.0);
			}
        }
        printf("[serv_log]  Load kvartiry. Load: %d b. Time: %d ms.",TotalKV,GetTickCount()-time);
  	}
    return true;
}


public LoadWarehouse()
{
	new rows, fields, temp[10],time = GetTickCount();
    cache_get_data(rows, fields);
    if(rows)
	{
		cache_get_field_content(0, "rostov_metal", temp), rostov_wh[0] = strval (temp);
		cache_get_field_content(0, "rostov_patr", temp), rostov_wh[1] = strval (temp);
		cache_get_field_content(0, "rostov_narko", temp), rostov_wh[2] = strval (temp);
		cache_get_field_content(0, "maykop_metal", temp), maykop_wh[0] = strval (temp);
		cache_get_field_content(0, "maykop_patr", temp), maykop_wh[1] = strval (temp);
		cache_get_field_content(0, "maykop_narko", temp), maykop_wh[2] = strval (temp);
		cache_get_field_content(0, "odessa_metal", temp), odessa_wh[0] = strval (temp);
		cache_get_field_content(0, "odessa_patr", temp), odessa_wh[1] = strval (temp);
		cache_get_field_content(0, "odessa_narko", temp), odessa_wh[2] = strval (temp);
		cache_get_field_content(0, "smi_money", temp), smi_money = strval (temp);
		
		cache_get_field_content(0, "army_metal", temp), army_wh[0] = strval (temp);
		cache_get_field_content(0, "army_patr", temp), army_wh[1] = strval (temp);
		
		rostov_sklad = CreateDynamicPickup(1279, 23, 2138.5845,-1770.8696,19.9222, 0);
		maykop_sklad = CreateDynamicPickup(1279, 23, 263.8759, 465.7279, 575.3100, 2);
		odessa_sklad = CreateDynamicPickup(1279, 23, 263.8759, 465.7279, 575.3100, 3);
		
		army_sklad = CreateDynamicPickup(3013, 23, 261.5260,2542.8245,417.8159, 1);


		new str1[256],str2[256],str3[256],str4[256];

		format(str1,sizeof(str1),"{3366FF}Бандера ОПГ\n{FFFFFF}Металла на складе: {FF6600}%d/30000 шт.\n{FFFFFF}Патронов на складе: {FF6600}%d/30000 шт.\n{FFFFFF}Наркотиков на складе: {FF6600}%d/30000 шт.",rostov_wh[0],rostov_wh[1],rostov_wh[2]);
		format(str2,sizeof(str2),"{3366FF}LEDERG ОПГ\n{FFFFFF}Металла на складе: {FF6600}%d/30000 шт.\n{FFFFFF}Патронов на складе: {FF6600}%d/30000 шт.\n{FFFFFF}Наркотиков на складе: {FF6600}%d/30000 шт.",maykop_wh[0],maykop_wh[1],maykop_wh[2]);
		format(str3,sizeof(str3),"{3366FF}Вагнер ОПГ\n{FFFFFF}Металла на складе: {FF6600}%d/30000 шт.\n{FFFFFF}Патронов на складе: {FF6600}%d/30000 шт.\n{FFFFFF}Наркотиков на складе: {FF6600}%d/30000 шт.",odessa_wh[0],odessa_wh[1],odessa_wh[2]);
		
		format(str4,sizeof(str4),"{3366FF}Склад армии\n{FFFFFF}Металла на складе: {FF6600}%d шт.\n{FFFFFF}Патронов на складе: {FF6600}%d шт.",army_wh[0],army_wh[1]);

		rostov_sklad_text = CreateDynamic3DTextLabel(str1, -1, 2138.5249, -1770.8383, 19.9222, 10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,0);
		maykop_sklad_text = CreateDynamic3DTextLabel(str2, -1, 263.8759, 465.7279, 575.3100, 10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,2,2);
		odessa_sklad_text = CreateDynamic3DTextLabel(str3, -1, 263.8759, 465.7279, 575.3100, 10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,3,3);
		
		army_sklad_text = CreateDynamic3DTextLabel(str4, -1, 261.5260,2542.8245,417.8159, 10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,1);



		printf("[serv_log]  Load warehouse. Time: %d ms.",GetTickCount()-time);
	}
	return true;
}



public LoadPolitMember(polit, playerid)
{
    new rows, fields;
    cache_get_data(rows, fields);
    if(rows)
    {
        new name[MAX_PLAYER_NAME],dtext[512];
    	for(new p = 0; p < rows; p++)
    	{
	        cache_get_field_content(p, "name", name, dbHandle, MAX_PLAYER_NAME);
	        if(strfind(POLIT_TEAM[polit][data_OWNER], name, true) != -1) format(dtext,sizeof(dtext),"%s\n{FFFFFF}%s - Основатель",dtext, name);
	        else format(dtext,sizeof(dtext),"%s\n{FFFFFF}%s\n",dtext, name);
        }
    	ShowPlayerDialogFix(playerid, dialog_OK, DIALOG_STYLE_MSGBOX, "{FFCC00}Состав партии", dtext, "Закрыть", "");
	}
	return true;
}

public LoadPolitMemberOFF()
{
    new rows, fields;
    cache_get_data(rows, fields);
    if(rows)
    {
        new name[MAX_PLAYER_NAME];
    	for(new p = 0; p < rows; p++)
    	{
	        cache_get_field_content(p, "name", name, dbHandle, MAX_PLAYER_NAME);
	        new query[120];
            format(query, sizeof(query), "UPDATE `accounts` SET `polit` = '0' WHERE `name` = '%s'",name);
  			mysql_function_query(dbHandle, query, false, "", "");
        }
	}
	return true;
}


public LoadDepPolitMember(polit, playerid)
{
    new rows, fields;
    cache_get_data(rows, fields);
    if(rows)
    {
        new name[MAX_PLAYER_NAME],dtext[512];
    	for(new p = 0; p < rows; p++)
    	{
	        cache_get_field_content(p, "name", name, dbHandle, MAX_PLAYER_NAME);
	        format(dtext,sizeof(dtext),"%s\n{FFFFFF}%s\n",dtext, name);
        }
    	ShowPlayerDialogFix(playerid, dialog_OK, DIALOG_STYLE_MSGBOX, "{FFCC00}Депутаты партии", dtext, "Закрыть", "");
	}
	else ShowPlayerDialogFix(playerid, dialog_OK, DIALOG_STYLE_MSGBOX, "{FFCC00}Депутаты партии", "{FFFFFF}У Вашей партии нет депутатов", "Закрыть", "");
	return true;
}


public LoadPolitT()
{
    new rows, fields, temp[256], time = GetTickCount();
    cache_get_data(rows, fields);
    TotalPolitT = 0;
    if(rows)
    {
    	for(new p = 0; p < rows; p++)
    	{
	        cache_get_field_content(p, "id", temp), POLIT_TEAM[p][data_ID] = strval (temp);
	        cache_get_field_content(p, "owner", POLIT_TEAM[p][data_OWNER], dbHandle, MAX_PLAYER_NAME);
	        cache_get_field_content(p, "name", POLIT_TEAM[p][data_NAME], dbHandle, 30);
	        cache_get_field_content(p, "deviz", POLIT_TEAM[p][data_DEVIZ], dbHandle, 50);
	        cache_get_field_content(p, "bank", temp), POLIT_TEAM[p][data_BANK] = strval (temp);
	        cache_get_field_content(p, "status", temp), POLIT_TEAM[p][data_STATUS] = strval (temp);
			for(new i = 0; i < MAX_PLAYERS; i++)
			{
			    if(!IsPlayerConnected(i)) continue;
			    if(strfind(POLIT_TEAM[p][data_OWNER], PLAYER_DATA[i][data_NAME], true) != -1)
				{
				    PLAYER_DATA[i][data_POLIT] = POLIT_TEAM[p][data_ID];
				    SavePlayerData(i);
				}
			}
         	TotalPolitT++;
        }
        printf("[serv_log]  Load polit. Load: %d p. Time: %d ms.",TotalPolitT, GetTickCount()-time);
	}
	return true;
}


public OffPMember(playerid,name[])
{
    new rows, fields, polit, temp[10];
    cache_get_data(rows, fields);
    if(rows)
	{
	    cache_get_field_content(0, "polit", temp), polit = strval (temp);



	    if(polit != PLAYER_DATA[playerid][data_POLIT]) return SendClientMessage(playerid,COLOR_WARNING, "Данный игрок не состоит в Вашей партии!");

	    for(new i = 0; i < MAX_PLAYERS; i++)
	    {
	        if(!IsPlayerConnected(i)) continue;
	        if(strcmp(PLAYER_DATA[i][data_NAME], name, true, 24) == 0)
	        {
	            SendClientMessage(i,COLOR_AC,"Вас выгнали из партии!");
				PLAYER_DATA[i][data_POLIT] = 0;
	        }
	    }
	    new query[120];
	    format(query, sizeof(query),"UPDATE `accounts` SET `polit` = '0' WHERE `name` = '%s'", name);
	    mysql_function_query(dbHandle, query, false, "", "");

	    new str[145];
	    format(str,sizeof(str),"[P] %s[%d] выгнал из партии оффлайн %s",PLAYER_DATA[playerid][data_NAME],playerid,name);
		SendPolitMessage(PLAYER_DATA[playerid][data_POLIT],COLOR_WARNING,str);
	}
	else SendClientMessage(playerid,COLOR_WARNING,"Данный акаунт не найден в базе данных!");
	return true;
}

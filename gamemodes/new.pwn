		}
		else SendClientMessage(playerid, COLOR_WARNING, "Вы уже где-то работаете!");
        return true;
    }
    
    if(pickupid == pickup_ash)
	{
	    if(PLAYER_DATA[playerid][data_LICB] == 1) return SendClientMessage(playerid,COLOR_WARNING,"У Вас уже есть водительские права!");
		if(PLAYER_DATA[playerid][data_ASH_TEST] == 1) return SendClientMessage(playerid,COLOR_WARNING,"Вы уже проходите тест!");

        ShowPlayerDialogFix(playerid, dialog_ASH_TEST, DIALOG_STYLE_MSGBOX, "{FFCC00}Экзамен по вождению", "{FFFFFF}Вы желаете получить водительские права?\nСтоимость экзамена: 5000 рублей", "Начать", "Отмена");
		return true;
	}
    
    if(pickupid == JB_DATA[0][data_PICKUP][1])
    {
        if(PLAYER_DATA[playerid][data_MEMBER] != 0) return SendClientMessage(playerid, COLOR_WARNING, "Вы состоите во фракции!");
        if(PLAYER_DATA[playerid][data_START_JOB] == 0 || PLAYER_DATA[playerid][data_START_JOB] == 2)
  		{
			if(PLAYER_DATA[playerid][data_START_JOB] == 0) ShowPlayerDialogFix(playerid, dialog_DREV_STARTJOB, DIALOG_STYLE_LIST, "{FFCC00}Лесопилка","Рабочий\nВодитель", "Начать", "Отмена");
			else ShowPlayerDialogFix(playerid, dialog_DREV_STOPJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Лесопилка","{FFFFFF}Вы желаете завершить рабочий день?", "Завершить", "Отмена");
		}
		else SendClientMessage(playerid, COLOR_WARNING, "Вы уже где-то работаете!");
        return true;
    }

    if(pickupid == JB_DATA[1][data_PICKUP][1])
    {
        if(PLAYER_DATA[playerid][data_MEMBER] != 0) return SendClientMessage(playerid, COLOR_WARNING, "Вы состоите во фракции!");
        if(PLAYER_DATA[playerid][data_START_JOB] == 0 || PLAYER_DATA[playerid][data_START_JOB] == 3)
  		{
			if(PLAYER_DATA[playerid][data_START_JOB] == 0) ShowPlayerDialogFix(playerid, dialog_SHAHTA_STARTJOB, DIALOG_STYLE_LIST, "{FFCC00}Шахта","Рабочий\nВодитель", "Начать", "Отмена");
			else ShowPlayerDialogFix(playerid, dialog_SHAHTA_STOPJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Шахта","{FFFFFF}Вы желаете завершить рабочий день?", "Завершить", "Отмена");
		}
		else SendClientMessage(playerid, COLOR_WARNING, "Вы уже где-то работаете!");
        return true;
    }
    if(pickupid == JB_DATA[2][data_PICKUP][1])
    {
        if(PLAYER_DATA[playerid][data_MEMBER] != 0) return SendClientMessage(playerid, COLOR_WARNING, "Вы состоите во фракции!");
        if(PLAYER_DATA[playerid][data_START_JOB] == 0 || PLAYER_DATA[playerid][data_START_JOB] == 4)

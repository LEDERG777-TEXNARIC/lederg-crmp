{
	ShowPlayerDialogFix(playerid, dialog_24_MENU, DIALOG_STYLE_LIST, "{FFCC00}24/7", "Номер телефона (250р)\nТелефон (500р)\nФотоаппарат (100р)\nТелефонная книга  (600р)\nАптечка (300р)\nМаска (300р)", "Купить", "Отмена");

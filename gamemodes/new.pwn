 	ShowPlayerDialogFix(playerid, dialog_GPS, DIALOG_STYLE_LIST, "{FFCC00}GPS", "Работа\nБанк\nАвтосалон\nВажные места\nБазы организаций\nПоиск дома\nПоиск подъезда\nПоиск бизнеса\nРазвлечения\nАвтошкола\nПодпольное казино", "Выбрать", "Отмена");

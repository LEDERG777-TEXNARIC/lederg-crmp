				if(get_player_money(playerid) < 100000) return SendClientMessage(playerid, COLOR_WARNING, "У Вас недостаточно денег! (100000 рублей)");
                ShowPlayerDialogFix(playerid,dialog_CREATE_POLIT_TEAM_1, DIALOG_STYLE_INPUT, "{FFCC00}Название партии", "{FFFFFF}Введите название Вашей будущей партии\n\nПримечание:\n- Название партии может состоять максимум из 25 символов\n- Разрешено использовать только русские буквы\n- Запрещено использовать различные запрещенные символы", "Далее", "Отмена");
			}
  		}
  		case dialog_CREATE_POLIT_TEAM_1:
  		{
  		    if(!response) return true;
  		    if(response)
  		    {
  		        if(PLAYER_DATA[playerid][data_POLIT] != 0) return SendClientMessage(playerid, COLOR_WARNING, "Вы уже состоите в политической партии!");
				if(get_player_money(playerid) < 100000) return SendClientMessage(playerid, COLOR_WARNING, "У Вас недостаточно денег! (100000 рублей)");
				if(strlen(inputtext) < 3 || strlen(inputtext) > 25)
				{
					SendClientMessage(playerid, COLOR_WARNING, "Название партии должно содержать не менее 3 и не более 25 символов!");
					ShowPlayerDialogFix(playerid,dialog_CREATE_POLIT_TEAM_1, DIALOG_STYLE_INPUT, "{FFCC00}Название партии", "{FFFFFF}Введите название Вашей будущей партии\n\nПримечание:\n - Название партии может состоять максимум из 25 символов\n - Разрешено использовать только русские буквы\n- Запрещено использовать различные запрещенные символы", "Далее", "Отмена");
					return true;
				}
				for(new i = strlen(inputtext); i != 0; --i)
				switch(inputtext[i])
				{
					case 'A'..'Z', 'a'..'z', ',', '`', '=':
					{
						SendClientMessage(playerid, 0x33CC33AA, "Разрешено использовать только русские буквы и цифры");

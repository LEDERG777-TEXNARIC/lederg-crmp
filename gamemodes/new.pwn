					    if(PLAYER_DATA[playerid][data_DRUGS] < strval(inputtext)) return SendClientMessage(playerid, COLOR_WARNING, "Недостаточно наркотиков!");
						if(met > 30000) return SendClientMessage(playerid, COLOR_WARNING,"На складе недостаточно места!");

                        PLAYER_DATA[playerid][data_DRUGS] -= strval(inputtext);
						odessa_wh[2] += strval(inputtext);


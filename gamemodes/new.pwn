public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    SetPVarInt(playerid,"pickup",pickupid);
    new b = GetPVarInt(playerid, "business");
    
    
    if(pickupid == army_sklad)
    {
        switch(PLAYER_DATA[playerid][data_MEMBER])
        {
            case 2,5,6,7:
			{
			    if(army_wh[0] > 3 && army_wh[1] > 3)
			    {
			        if(PLAYER_DATA[playerid][data_PATR] < 500 && PLAYER_DATA[playerid][data_MET] < 500)
			        {
						new patr,met,str[28];
						patr = RandomEX(1,3);
						met = RandomEX(1,3);
			            PLAYER_DATA[playerid][data_PATR] += patr;
			            PLAYER_DATA[playerid][data_MET] += met;
			            if(PLAYER_DATA[playerid][data_PATR] > 500) PLAYER_DATA[playerid][data_PATR] = 500;
			            if(PLAYER_DATA[playerid][data_MET] > 500) PLAYER_DATA[playerid][data_MET] = 500;
			            
			            army_wh[0] -= met;
			            army_wh[1] -= patr;
			            format(str,sizeof(str),"~p~met +%d~n~patr +%d",met,patr);
			         	GameTextForPlayer(playerid, str, 1000, 6);
			        }
			        else if(PLAYER_DATA[playerid][data_PATR] < 500 && PLAYER_DATA[playerid][data_MET] == 500)
			        {
			            new patr,str[28];
						patr = RandomEX(1,3);
			            PLAYER_DATA[playerid][data_PATR] += patr;
			            if(PLAYER_DATA[playerid][data_PATR] > 500) PLAYER_DATA[playerid][data_PATR] = 500;

			            army_wh[1] -= patr;
			            
			            format(str,sizeof(str),"~p~patr +%d",patr);
			         	GameTextForPlayer(playerid, str, 1000, 6);
			        }
			        else if(PLAYER_DATA[playerid][data_PATR] == 500 && PLAYER_DATA[playerid][data_MET] < 500)
			        {
			            new met,str[28];
						met = RandomEX(1,3);
			            PLAYER_DATA[playerid][data_MET] += met;
			            if(PLAYER_DATA[playerid][data_MET] > 500) PLAYER_DATA[playerid][data_MET] = 500;


                        army_wh[0] -= met;
			            
			            format(str,sizeof(str),"~p~met +%d",met);
			         	GameTextForPlayer(playerid, str, 1000, 6);
			        }
			        else GameTextForPlayer(playerid, "~r~is full", 1000, 6);
			    }
			    else if(army_wh[0] < 3 && army_wh[1] > 3)
			    {
			        if(PLAYER_DATA[playerid][data_PATR] < 500)
			        {
			            new patr,str[28];
						patr = RandomEX(1,3);
			            PLAYER_DATA[playerid][data_PATR] += patr;
			            if(PLAYER_DATA[playerid][data_PATR] > 500) PLAYER_DATA[playerid][data_PATR] = 500;


			            army_wh[1] -= patr;
			            
			            format(str,sizeof(str),"~p~patr +%d",patr);
			         	GameTextForPlayer(playerid, str, 1000, 6);
			        }
                    else GameTextForPlayer(playerid, "~r~is full", 1000, 6);
			    }
			    else if(army_wh[0] > 3 && army_wh[1] < 3)
			    {
			        if(PLAYER_DATA[playerid][data_MET] < 500)
			        {
			            new met,str[28];
						met = RandomEX(1,3);
			            PLAYER_DATA[playerid][data_MET] += met;
			            if(PLAYER_DATA[playerid][data_MET] > 500) PLAYER_DATA[playerid][data_MET] = 500;

                        army_wh[0] -= met;
			            
			            format(str,sizeof(str),"~p~met +%d",met);
			         	GameTextForPlayer(playerid, str, 1000, 6);
			        }
			        else GameTextForPlayer(playerid, "~r~is full", 1000, 6);
			    }
			    else GameTextForPlayer(playerid, "~r~empty", 1000, 6);
			    
			    new str1[256];
            	format(str1,sizeof(str1),"{3366FF}Склад армии\n{FFFFFF}Металла на складе: {FF6600}%d шт.\n{FFFFFF}Патронов на складе: {FF6600}%d шт.",army_wh[0],army_wh[1]);
       			UpdateDynamic3DTextLabelText(army_sklad_text, -1, str1);
			}
        }
        return true;
    }
    
    if(pickupid == JB_DATA[0][data_PICKUP][0] || pickupid == JB_DATA[1][data_PICKUP][0] || pickupid == JB_DATA[2][data_PICKUP][0] ||
	pickupid == JB_DATA[3][data_PICKUP][0] || pickupid == AB_DATA[0][data_PICKUP][0] || pickupid == AB_DATA[1][data_PICKUP][0])
	{
	    return true;
	}
    
    if(PLAYER_DATA[playerid][data_PU] == 1) return false;
	else
	{
		PLAYER_DATA[playerid][data_PU] = 1;
		GetPlayerPos(playerid, PosPU[0][playerid], PosPU[1][playerid], PosPU[2][playerid]);
	}
	

	for(new h = 0; h < TotalHouses; h++)
	{
		if(HOUSE_DATA[h][data_PICKUPENTER] == pickupid)
		{
			SetPVarInt(playerid, "house", h);
	      	new dtext[140];
	       	if(HOUSE_DATA[h][data_OWNED] == 1)
	      	{
				new h_online[24];
				for(new x = 0; x < MAX_PLAYERS; x++)
				{
					if(!IsPlayerConnected(x)) continue;
					if(PLAYER_DATA[x][data_HOUSE] == h)
					{
						strmid(h_online, "{339933}online{FFFFFF}", 0, 24, 24);
						break;
					}
					else strmid(h_online, "{FF0000}offline{FFFFFF}", 0, 24, 24);
				}
		  		format(dtext,sizeof(dtext),"{FFFFFF}Номер дома: %d\nВладелец: %s [%s]\nСтоимость: %d рублей\n\n{D0FA58}Оплачен на %d дня/дней",h+1, HOUSE_DATA[h][data_OWNER],h_online, HOUSE_DATA[h][data_PRICE], HOUSE_DATA[h][data_DAY]);
		  		ShowPlayerDialogFix(playerid, dialog_ENTER_HOUSE, DIALOG_STYLE_MSGBOX, "{FFCC00}Дом", dtext, "Войти", "Отмена");
              	return true;
			}
	    	else
	      	{
	    		format(dtext,sizeof(dtext),"{FFFFFF}Номер дома: %d\nСтоимость: %d рублей\n\n{FFCC00}Для покупки дома используйте: /buy",h+1,HOUSE_DATA[h][data_PRICE]);
		     	ShowPlayerDialogFix(playerid, dialog_ENTER_HOUSE, DIALOG_STYLE_MSGBOX, "{FFCC00}Дом", dtext, "Войти", "Отмена");
              	return true;
			}
		}
	}
	if(pickupid == rentcater)
	{
		ShowPlayerDialogFix(playerid, dialog_RENTCATER, DIALOG_STYLE_MSGBOX, "{FFCC00}Аренда катера", "{FFFFFF}Вы желаете арендовать прогулочный катер за 25.000 рублей?", "Арендовать", "Отмена");
		return true;
	}
	
	
	
	
	if(pickupid == pickcartrack)
	{
		if(PLAYER_DATA[playerid][data_CT_NUMBER] != 0) return SendClientMessage(playerid, COLOR_WARNING,"Вы уже зарегистрировались на участие в гонке!");
	    if(cartrack_status == false) return SendClientMessage(playerid, COLOR_WARNING, "В данный момент регистрация участников закрыта!");
		if(cartrack_people >= 15) return SendClientMessage(playerid, COLOR_WARNING, "Нет свободных мест!");
		if(PLAYER_DATA[playerid][data_LICB] == 0) return SendClientMessage(playerid, COLOR_WARNING, "У Вас нет водительских прав!");
		new str[145];
		format(str,sizeof(str),"Вы успешно зарегистрировались. Ваш номер: %d",cartrack_people+1);
		SendClientMessage(playerid, 0xFFFF66FF, str);
		cartrack_people++;
		PLAYER_DATA[playerid][data_CT_NUMBER] = cartrack_people;
		return true;
	}
	
	if(pickupid == pickcs)
	{
		if(PLAYER_DATA[playerid][data_CS_TEAM] != 0) return SendClientMessage(playerid, COLOR_WARNING,"Вы уже зарегистрировались на игру!");
	    if(cs_status == false) return SendClientMessage(playerid, COLOR_WARNING, "В данный момент регистрация участников закрыта!");
		if(cs_people >= 20) return SendClientMessage(playerid, COLOR_WARNING, "Нет свободных мест!");
		
		if(cs_people%2 == 0)
		{
			SendClientMessage(playerid, 0xFFFF66FF,"Вы успешно зарегистрировались. Ваша команда: Армия");
			PLAYER_DATA[playerid][data_CS_TEAM] = 1;
		}
		else
		{
		    SendClientMessage(playerid, 0xFFFF66FF,"Вы успешно зарегистрировались. Ваша команда: ОМОН");
		    PLAYER_DATA[playerid][data_CS_TEAM] = 2;
		}
		cs_people++;
		return true;
	}
	
	
	if(pickupid == pickgmats)
	{
		switch(PLAYER_DATA[playerid][data_MEMBER])
		{
		    case 2:
		    {
		        if(PLAYER_DATA[playerid][data_PUTPATR] == 0 && PLAYER_DATA[playerid][data_PUTMET] == 0)
		        {
		            PLAYER_DATA[playerid][data_PUTPATR] = 1;
		            SetPlayerAttachedObject(playerid, 3, 3013,5,0.040999,0.202999,0.192999,101.299987,1.999999,75.800003,1.000000,1.000000,1.000000);
		    		SetPlayerSpecialAction(playerid,25);
					SendClientMessage(playerid, -1, "Подойдите к грузовику и введите: /put");
		        }
		    }
		}
		return true;
	}
	if(pickupid == pickgmets)
	{
		switch(PLAYER_DATA[playerid][data_MEMBER])
		{
		    case 2:
		    {
		        if(PLAYER_DATA[playerid][data_PUTMET] == 0 && PLAYER_DATA[playerid][data_PUTPATR] == 0)
		        {
		            PLAYER_DATA[playerid][data_PUTMET] = 1;
		            SetPlayerAttachedObject(playerid, 3, 3013,5,0.040999,0.202999,0.192999,101.299987,1.999999,75.800003,1.000000,1.000000,1.000000);
		    		SetPlayerSpecialAction(playerid,25);
					SendClientMessage(playerid, -1, "Подойдите к грузовику и введите: /put");
		        }
		    }
		}
	    return true;
	}
	
	
	if(pickupid == rostov_sklad && PLAYER_DATA[playerid][data_MEMBER] == 5)
	{
	    ShowPlayerDialogFix(playerid, dialog_SKLAD, DIALOG_STYLE_LIST, "{FFCC00}Склад", "{FFFFFF}Взять металл со склада\nПоложить металл на склад\nВзять патроны со склада\nПоложить патроны на склад\nВзять наркотики со склада\nПоложить наркотики на склад", "Выбрать", "Отмена");
		return true;
	}
	if(pickupid == maykop_sklad && PLAYER_DATA[playerid][data_MEMBER] == 6)
	{
	    ShowPlayerDialogFix(playerid, dialog_SKLAD, DIALOG_STYLE_LIST, "{FFCC00}Склад", "{FFFFFF}Взять металл со склада\nПоложить металл на склад\nВзять патроны со склада\nПоложить патроны на склад\nВзять наркотики со склада\nПоложить наркотики на склад", "Выбрать", "Отмена");
        return true;
	}
	if(pickupid == odessa_sklad && PLAYER_DATA[playerid][data_MEMBER] == 7)
	{
	    ShowPlayerDialogFix(playerid, dialog_SKLAD, DIALOG_STYLE_LIST, "{FFCC00}Склад", "{FFFFFF}Взять металл со склада\nПоложить металл на склад\nВзять патроны со склада\nПоложить патроны на склад\nВзять наркотики со склада\nПоложить наркотики на склад", "Выбрать", "Отмена");
        return true;
	}

    if(pickupid == Vibory_mayor)
	{
	    if(PLAYER_DATA[playerid][data_LVL] < 2) return SendClientMessage(playerid,COLOR_WARNING,"Для участия в выборах требуется 3 уровень!");

        if(PLAYER_DATA[playerid][data_GOLOS] == 1) return SendClientMessage(playerid, COLOR_WARNING, "Вы уже отдали свой голос!");
		if(strcmp(VIBORY_DATA[1][data_NAME], "None", true, MAX_PLAYER_NAME) == 0)
		{
		    new dtext[MAX_PLAYER_NAME+1];
			format(dtext,sizeof(dtext),"%s",VIBORY_DATA[0][data_NAME]);
			ShowPlayerDialogFix(playerid, dialog_VIBORY, DIALOG_STYLE_LIST, "{FFCC00}Выберите кандидата", dtext, "Выбрать", "Отмена");
            return true;
		}
		else if(strcmp(VIBORY_DATA[2][data_NAME], "None", true, MAX_PLAYER_NAME) == 0)
		{
		    new dtext[2*MAX_PLAYER_NAME+1];
		    format(dtext,sizeof(dtext),"%s\n%s",VIBORY_DATA[0][data_NAME],VIBORY_DATA[1][data_NAME]);
		    ShowPlayerDialogFix(playerid, dialog_VIBORY, DIALOG_STYLE_LIST, "{FFCC00}Выберите кандидата", dtext, "Выбрать", "Отмена");
            return true;
		}
		else if(strcmp(VIBORY_DATA[3][data_NAME], "None", true, MAX_PLAYER_NAME) == 0)
		{
		    new dtext[3*MAX_PLAYER_NAME+1];
            format(dtext,sizeof(dtext),"%s\n%s\n%s",VIBORY_DATA[0][data_NAME],VIBORY_DATA[1][data_NAME],VIBORY_DATA[2][data_NAME]);
            ShowPlayerDialogFix(playerid, dialog_VIBORY, DIALOG_STYLE_LIST, "{FFCC00}Выберите кандидата", dtext, "Выбрать", "Отмена");
            return true;
		}
		else if(strcmp(VIBORY_DATA[4][data_NAME], "None", true, MAX_PLAYER_NAME) == 0)
		{
		    new dtext[4*MAX_PLAYER_NAME+1];
            format(dtext,sizeof(dtext),"%s\n%s\n%s\n%s",VIBORY_DATA[0][data_NAME],VIBORY_DATA[1][data_NAME],VIBORY_DATA[2][data_NAME],VIBORY_DATA[3][data_NAME]);
            ShowPlayerDialogFix(playerid, dialog_VIBORY, DIALOG_STYLE_LIST, "{FFCC00}Выберите кандидата", dtext, "Выбрать", "Отмена");
            return true;
		}
		else
		{
		    new dtext[5*MAX_PLAYER_NAME+1];
		    format(dtext,sizeof(dtext),"%s\n%s\n%s\n%s\n%s",VIBORY_DATA[0][data_NAME],VIBORY_DATA[1][data_NAME],VIBORY_DATA[2][data_NAME],VIBORY_DATA[3][data_NAME],VIBORY_DATA[4][data_NAME]);
            ShowPlayerDialogFix(playerid, dialog_VIBORY, DIALOG_STYLE_LIST, "{FFCC00}Выберите кандидата", dtext, "Выбрать", "Отмена");
			return true;
		}
	}
	if(pickupid == PolitT_mayor)
	{
	    //SendClientMessage(playerid,COLOR_WARNING, "В данный момент недоступно!");

	    if(PLAYER_DATA[playerid][data_POLIT] != 0) return SendClientMessage(playerid,COLOR_WARNING,"В данный момент вы состоите в политической партии!");

		ShowPlayerDialogFix(playerid, dialog_CREATE_POLIT_TEAM, DIALOG_STYLE_MSGBOX, "{FFCC00}Регистрация политической партии", "{FFFFFF}Вы желаете зарегистрировать свою политическую партию?\nДанная услуга Вам будет стоить 100000 рублей\n\nЧленам партии доступна возможность участвовать в политической жизни области", "Далее", "Отмена");
		return true;
	}
	
	
	if(pickupid == casino_info)
	{
	    ShowPlayerDialogFix(playerid, dialog_OK, DIALOG_STYLE_MSGBOX, "{FFCC00}Казино", "{FFFFFF}Добро пожаловать в подпольное казино!\nПотом допишу крч...", "Закрыть", "");
	    return true;
	}
	
	if(pickupid == pickhparmy)
	{
	    SetPlayerHealthAC(playerid, 100);
		SetPlayerArmourAC(playerid, 100);
		return true;
	}
	
	if(pickupid == pickgunmayor)
	{
		if(PLAYER_DATA[playerid][data_MEMBER] == 1) return ShowPlayerDialogFix(playerid, dialog_GUN_POLICE, DIALOG_STYLE_LIST, "{FFCC00}Склад", "Убойный пистолет (50 патрон)\nАвтомат (250 патрон)\nДубинка\nАптечка\nБронежилет\nЗащитный щит", "Выбрать", "Отмена");
		else SendClientMessage(playerid,COLOR_WARNING,"Данный склад Вам недоступен!");
		return true;
	}
	
    if(pickupid == pickgunpolice)
	{
		if(PLAYER_DATA[playerid][data_MEMBER] == 3 || PLAYER_DATA[playerid][data_MEMBER] == 8) return ShowPlayerDialogFix(playerid, dialog_GUN_POLICE, DIALOG_STYLE_LIST, "{FFCC00}Склад", "Убойный пистолет (50 патрон)\nАвтомат (250 патрон)\nДубинка\nАптечка\nБронежилет\nЗащитный щит\nЖезл", "Выбрать", "Отмена");
		else SendClientMessage(playerid,COLOR_WARNING,"Данный склад Вам недоступен!");
		return true;
	}

	
	//if(pickupid == pickgunfsb)
	//{
	//	if(PLAYER_DATA[playerid][data_MEMBER] != 8) return SendClientMessage(playerid,COLOR_WARNING,"Данный склад Вам недоступен!");
	//	ShowPlayerDialogFix(playerid, dialog_GUN_POLICE, DIALOG_STYLE_LIST, "{FFCC00}Склад", "Убойный пистолет (50 патрон)\nАвтомат (250 патрон)\nДубинка\nАптечка\nБронежилет\nЗащитный щит", "Выбрать", "Отмена");
	//	return true;
	//}
	
    if(pickupid == pickbuycar)
	{
	    if(PLAYER_DATA[playerid][data_HOUSE] == INVALID_HOUSE_ID && PLAYER_DATA[playerid][data_KV] == INVALID_KV_ID) return SendClientMessage(playerid,COLOR_WARNING,"У Вас нет дома/квартиры!");

		for(new c = 0; c < 3; c++)
		{
			if(PLAYER_DATA[playerid][data_CAR][c] == 0)
			{
			    SendClientMessage(playerid,COLOR_AC,"Для Выхода из автосалона используйте 'ESC'");

			    PLAYER_DATA[playerid][data_CHANGECAR] = 0;

				new info1[50],info2[50],info3[50];
				format(info1,sizeof(info1),"Donate: %d",autosalon_cars[0][asDonate]);
				format(info2,sizeof(info2),"Money: %d",autosalon_cars[0][asCena]);
				format(info3,sizeof(info3),"Class: %s",autosalon_cars[0][asClass]);
				
				PlayerTextDrawSetString(playerid,AutoSalon_Stats[playerid][0],info1);
			    PlayerTextDrawSetString(playerid,AutoSalon_Stats[playerid][1],info2);
			    PlayerTextDrawSetString(playerid,AutoSalon_Stats[playerid][2],info3);
			    
			    SetPlayerPosAC(playerid,178.504730, -138.539718, 1002.653076+20.0);
			    InterpolateCameraPos(playerid, 171.725631, -138.890823, 1004.574829, 171.725631, -138.890823, 1004.574829, 1000);
				InterpolateCameraLookAt(playerid, 176.567260, -138.837310, 1003.327575, 176.574020, -138.837234, 1003.354064, 1000);
				FreezePlayer(playerid);
				SetTimerEx("UnfreezePlayer", 4000, false, "d", playerid);

			    PLAYER_DATA[playerid][data_AUTOSALON_CAR] = CreateVehicle(autosalon_cars[PLAYER_DATA[playerid][data_CHANGECAR]][asModel], 2305.5500, -1774.2261, 22.3662, 92.8394, PLAYER_DATA[playerid][data_ONECOLOR_AS], PLAYER_DATA[playerid][data_TWOCOLOR_AS], 36000);
			    LinkVehicleToInterior(PLAYER_DATA[playerid][data_AUTOSALON_CAR], 1);
			   	SetVehicleVirtualWorld(PLAYER_DATA[playerid][data_AUTOSALON_CAR], playerid);
				SetPlayerInterior(playerid,1);
			    SetPlayerVirtualWorld(playerid,playerid);

				ShowAutoSalonMenu(playerid);
				return true;
			}
		}
        SendClientMessage(playerid,COLOR_WARNING,"Продайте один из трёх автомобилей, чтобы освободить слот для нового транспорта!");
        
		return true;
	}
	
    if(pickupid == pick_bank[0] || pickupid == pick_bank[1] || pickupid == pick_bank[2])
	{
		ShowPlayerDialogFix(playerid, dialog_BANK, DIALOG_STYLE_LIST, "{FFCC00}Банк", "Проверить баланс\nСнять деньги со счета\nПоложить деньги на счет\nПоложить деньги на счет телефона\nЗаплатить за дом\nЗаплатить за квартиру\nЗаплатить за бизнес", "Выбрать", "Отмена");
		return true;
	}
	
	if(pickupid == pick_prodjob)
    {
        if(PLAYER_DATA[playerid][data_MEMBER] != 0) return SendClientMessage(playerid, COLOR_WARNING, "Вы состоите во фракции!");
        if(PLAYER_DATA[playerid][data_START_JOB] == 0 || PLAYER_DATA[playerid][data_START_JOB] == 8)
  		{
			if(PLAYER_DATA[playerid][data_START_JOB] == 0) ShowPlayerDialogFix(playerid, dialog_PROD_STARTJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Главный склад","{FFFFFF}Вы желаете начать рабочий день?\n\n{3399FF}Для работы требуется 3 уровень", "Начать", "Отмена");
			else ShowPlayerDialogFix(playerid, dialog_PROD_STOPJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Главный склад","{FFFFFF}Вы желаете завершить рабочий день?", "Завершить", "Отмена");
		}
		else SendClientMessage(playerid, COLOR_WARNING, "Вы уже где-то работаете!");
        return true;
    }
	 
    if(pickupid == pick_ashanjob)
    {
        if(PLAYER_DATA[playerid][data_MEMBER] != 0) return SendClientMessage(playerid, COLOR_WARNING, "Вы состоите во фракции!");

						strcat(dtext, "{FFFFFF}/skick [ид] - тихо кикнуть игрока\n");
						strcat(dtext, "{FFFFFF}/sethp [ид] [кол-во] - изменить уровень здоровья у игрока\n");
						strcat(dtext, "{FFFFFF}/warn [ид] [время] [причина] - выдать предупреждение игроку\n");
						strcat(dtext, "{FFFFFF}/unwarn [ид] - снять предупреждение с игрока\n");

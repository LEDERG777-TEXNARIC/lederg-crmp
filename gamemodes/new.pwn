				if(strlen(inputtext) < 6 || strlen(inputtext) > 30) return SendClientMessage(playerid, 0x33CC33AA,"Длина пароля должна быть от 6 до 30 символов!"),ShowPlayerDialogFix(playerid, dialog_SETTING_1, DIALOG_STYLE_INPUT,"{FFCC00}Изменение пароля","Введите свой старый пароль", "Далее", "Отмена");

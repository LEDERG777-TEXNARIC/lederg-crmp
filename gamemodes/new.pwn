	{
		format(str,sizeof(str),"{FFFFFF}Подразделение:\t\t%s\n", podfrak);
		strcat(sctring,str);
	}
	switch(PLAYER_DATA[playerid][data_MEMBER])
 	{
 	    case 0:format(str,sizeof(str),"Должность:\t\t\tНет\n"),strcat(sctring,str);
 	    case 1:format(str,sizeof(str),"Должность:\t\t\t%s\n",rang_gov[PLAYER_DATA[playerid][data_RANK]-1][frName]),strcat(sctring,str);
		case 2:format(str,sizeof(str),"Звание:\t\t\t%s\n",rang_army[PLAYER_DATA[playerid][data_RANK]-1][frName]),strcat(sctring,str);

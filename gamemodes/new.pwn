				    case 22: PLAYER_DATA[playerid][data_MET] -= 100;
				    case 23: PLAYER_DATA[playerid][data_MET] -= 125;
				    case 24: PLAYER_DATA[playerid][data_MET] -= 200;
				    case 25: PLAYER_DATA[playerid][data_MET] -= 200;
				    case 29: PLAYER_DATA[playerid][data_MET] -= 250;
				    case 30: PLAYER_DATA[playerid][data_MET] -= 300;
				    case 34: PLAYER_DATA[playerid][data_MET] -= 500;
				}
				
			}
		}

			if(PLAYER_DATA[playerid][data_START_JOB] == 0) ShowPlayerDialogFix(playerid, dialog_YABLO_STARTJOB, DIALOG_STYLE_LIST, "{FFCC00}Сад","Рабочий\nВодитель", "Начать", "Отмена");
			else ShowPlayerDialogFix(playerid, dialog_YABLO_STOPJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Сад","{FFFFFF}Вы желаете завершить рабочий день?", "Завершить", "Отмена");
		}
		else SendClientMessage(playerid, COLOR_WARNING, "Вы уже где-то работаете!");
        return true;
    }

    if(pickupid == JB_DATA[3][data_PICKUP][1])
    {
        if(PLAYER_DATA[playerid][data_MEMBER] != 0) return SendClientMessage(playerid, COLOR_WARNING, "Вы состоите во фракции!");
        if(PLAYER_DATA[playerid][data_START_JOB] == 0 || PLAYER_DATA[playerid][data_START_JOB] == 5)
  		{
			if(PLAYER_DATA[playerid][data_START_JOB] == 0) ShowPlayerDialogFix(playerid, dialog_OGOROD_STARTJOB, DIALOG_STYLE_LIST, "{FFCC00}Огород","Рабочий\nВодитель", "Начать", "Отмена");
			else ShowPlayerDialogFix(playerid, dialog_OGOROD_STOPJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Огород","{FFFFFF}Вы желаете завершить рабочий день?", "Завершить", "Отмена");
		}
		else SendClientMessage(playerid, COLOR_WARNING, "Вы уже где-то работаете!");
        return true;
    }
    
    
    
    if(pickupid == AB_DATA[0][data_PICKUP][1])
    {
        if(PLAYER_DATA[playerid][data_MEMBER] != 0) return SendClientMessage(playerid, COLOR_WARNING, "Вы состоите во фракции!");
        if(PLAYER_DATA[playerid][data_START_JOB] == 0 || PLAYER_DATA[playerid][data_START_JOB] == 6)
  		{
			if(PLAYER_DATA[playerid][data_START_JOB] == 0) ShowPlayerDialogFix(playerid, dialog_AB1_STARTJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Автобаза","{ffffff}Вы желаете начать рабочий день?\n\n{3399FF}Для работы требуется 5 уровень", "Начать", "Отмена");
			else ShowPlayerDialogFix(playerid, dialog_AB1_STOPJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Автобаза","{FFFFFF}Вы желаете завершить рабочий день?", "Завершить", "Отмена");
		}
		else SendClientMessage(playerid, COLOR_WARNING, "Вы уже где-то работаете!");
        return true;
    }

    if(pickupid == AB_DATA[1][data_PICKUP][1])
    {
        if(PLAYER_DATA[playerid][data_MEMBER] != 0) return SendClientMessage(playerid, COLOR_WARNING, "Вы состоите во фракции!");
        if(PLAYER_DATA[playerid][data_START_JOB] == 0 || PLAYER_DATA[playerid][data_START_JOB] == 7)
  		{
			if(PLAYER_DATA[playerid][data_START_JOB] == 0) ShowPlayerDialogFix(playerid, dialog_AB2_STARTJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Автобаза" , "{ffffff}Вы желаете начать рабочий день?\n\n{3399FF}Для работы требуется 5 уровень", "Начать", "Отмена");
			else ShowPlayerDialogFix(playerid, dialog_AB2_STOPJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Автобаза" , "{FFFFFF}Вы желаете завершить рабочий день?", "Завершить", "Отмена");
		}
		else SendClientMessage(playerid, COLOR_WARNING, "Вы уже где-то работаете!");
        return true;
    }
    
	if(pickupid == BUSINESS_DATA[b][data_CHEK])
	{
		ShowBusinessMenu(playerid,b);
		return true;
	}
	
	for(new i = 0; i < sizeof(podarok_pos); i++)
    {
        if(PlayerToPoint(2.0, playerid, podarok_pos[i][0], podarok_pos[i][1], podarok_pos[i][2]))
        {
			if(PLAYER_DATA[playerid][data_PODAROK][i] != 0) return SendClientMessage(playerid, COLOR_WARNING, "Вы уже брали сегодня этот подарок!");
            PLAYER_DATA[playerid][data_PODAROK][i] = 1;
            switch(random(6))
            {
                case 0:
                {
                    give_player_money(playerid, 9500, "pod");
                    SendClientMessage(playerid, 0x33CC99FF, "Вы подобрали подарок. Получено: 9500 рублей");
                }
                case 1:
                {
                    give_player_money(playerid, 7050, "pod");
                    SendClientMessage(playerid, 0x33CC99FF, "Вы подобрали подарок. Получено: 7050 рублей");
                }
                case 2:
                {
                    give_player_money(playerid, 5200, "pod");
                    SendClientMessage(playerid, 0x33CC99FF, "Вы подобрали подарок. Получено: 5200 рублей");
                }
                case 3:
                {
                    give_player_money(playerid, 1150, "pod");
                    SendClientMessage(playerid, 0x33CC99FF, "Вы подобрали подарок. Получено: 1150 рублей");
                }
                case 4:
                {
					give_player_money(playerid, 560, "pod");
                    SendClientMessage(playerid, 0x33CC99FF, "Вы подобрали подарок. Получено: 560 рублей");
                }
                case 5:
                {
					give_player_money(playerid, 120, "pod");
                    SendClientMessage(playerid, 0x33CC99FF, "Вы подобрали подарок. Получено: 120 рублей");
                }
            }
			return true;
		}
    }
    
    
	return true;
}


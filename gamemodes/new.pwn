		{
		    if(PLAYER_DATA[playerid][data_RANK] < 14) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		default: return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");

	}
	if(sscanf(params,"ud",params[0],params[1])) return SendClientMessage(playerid,COLOR_WARNING,"Используйте: /setpod [ид] [0 - ППС, 1 - ГИБДД, 2 - ОМОН]");
	if(!IsPlayerConnected(params[0]))return  SendClientMessage(playerid,COLOR_WARNING,"Данного ID нет на сервере!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Данный игрок не прошел авторизацию!");
	if(PLAYER_DATA[params[0]][data_MEMBER] == 0) return SendClientMessage(playerid, COLOR_WARNING, "Данный игрок не состоит в Вашей организации!");
	if(PLAYER_DATA[playerid][data_MEMBER] != PLAYER_DATA[params[0]][data_MEMBER]) return SendClientMessage(playerid, COLOR_WARNING, "Данный игрок не состоит в Вашей организации!");
	if(params[1] < 0 || params[1] > 2) return SendClientMessage(playerid,COLOR_WARNING,"Используйте: /setpod [ид] [0 - ППС, 1 - ГИБДД]");
	
	PLAYER_DATA[params[0]][data_PODMEMBER] = params[1];
	
	new podfrak[6],str[145];
	switch(PLAYER_DATA[params[0]][data_PODMEMBER])
	{
	    case 0: podfrak = "ППС";
		case 1: podfrak = "ГИБДД";
		case 2: podfrak = "ОМОН";
	}
	format(str,sizeof(str),"%s новое подразделение %s",PLAYER_DATA[params[0]][data_NAME],podfrak);
	SendClientMessage(playerid, 0x33CC99FF, str), SendClientMessage(params[0], 0x33CC99FF, str);
	return true;
}


CMD:setrank(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Вы не авторизованы на сервере!");

	switch(PLAYER_DATA[playerid][data_MEMBER])
	{
		case 1:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 6) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		case 2:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 13) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		case 3:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 14) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		case 4:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 5) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		case 5,6,7:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 6) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		case 8:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 13) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		case 9:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 6) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		default: return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");

	}
	
	if(sscanf(params,"u",params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Используйте: /setrank [ид]");
	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_WARNING,"Нельзя использовать на самом себе!");
	if(!IsPlayerConnected(params[0]))return  SendClientMessage(playerid,COLOR_WARNING,"Данного ID нет на сервере!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Данный игрок не прошел авторизацию!");
	if(PLAYER_DATA[params[0]][data_MEMBER] == 0) return SendClientMessage(playerid, COLOR_WARNING, "Данный игрок не состоит в Вашей организации!");
	if(PLAYER_DATA[playerid][data_MEMBER] != PLAYER_DATA[params[0]][data_MEMBER]) return SendClientMessage(playerid, COLOR_WARNING, "Данный игрок не состоит в Вашей организации!");
	if(PLAYER_DATA[params[0]][data_LEADER] != 0) return SendClientMessage(playerid, COLOR_WARNING, "Нельзя применить к лидеру!");
	SetPVarInt(playerid,"gPLAYER",params[0]);
	switch(PLAYER_DATA[playerid][data_MEMBER])
	{
		case 1:ShowPlayerDialogFix(playerid, dialog_SETRANK, DIALOG_STYLE_LIST, "{FFCC00}Выберете должность", "Водитель\nОхраник\nСекретарь\nАдвокат\nДепутат\nГлавный советник", "Выбрать", "Отмена");
		case 2:ShowPlayerDialogFix(playerid, dialog_SETRANK, DIALOG_STYLE_LIST, "{FFCC00}Выберете должность", "Рядовой\nЕфрейтор\nМл.Сержант\nСержант\nСт.Сержант\nСтаршина\nМл.Лейтенант\nЛейтенант\nСт.Лейтенант\nКапитан\nМайор\nПодполковник\nПолковник", "Выбрать", "Отмена");
		case 3:ShowPlayerDialogFix(playerid, dialog_SETRANK, DIALOG_STYLE_LIST, "{FFCC00}Выберете должность", "Рядовой\nМл.Сержант\nСержант\nСт.Сержант\nСтаршина\nПрапорщик\nСт.Прапорщик\nМл.Лейтенант\nЛейтенант\nСт.Лейтенант\nКапитан\nМайор\nПодполковник\nПолковник", "Выбрать", "Отмена");
		case 4:ShowPlayerDialogFix(playerid, dialog_SETRANK, DIALOG_STYLE_LIST, "{FFCC00}Выберете должность", "Практикант\nСанитар\nМед.брат\nВрач-специалист\nЗав.Отделением", "Выбрать", "Отмена");
		case 5,6,7:ShowPlayerDialogFix(playerid, dialog_SETRANK, DIALOG_STYLE_LIST, "{FFCC00}Выберете должность", "Шестерка\nШерсть\nШнырь\nБосяк\nДжиган\nБригадир", "Выбрать", "Отмена");
        case 8:ShowPlayerDialogFix(playerid, dialog_SETRANK, DIALOG_STYLE_LIST, "{FFCC00}Выберете должность", "Рядовой\nЕфрейтор\nМл.Сержант\nСержант\nСт.Сержант\nСтаршина\nМл.Лейтенант\nЛейтенант\nСт.Лейтенант\nКапитан\nМайор\nПодполковник\nПолковник", "Выбрать", "Отмена");
        case 9:ShowPlayerDialogFix(playerid, dialog_SETRANK, DIALOG_STYLE_LIST, "{FFCC00}Выберете должность", "Стажер\nОператор\nРепортер\nРежисер\nТехнический специалист\nЗам.Директора", "Выбрать", "Отмена");
	}
	return true;
}

CMD:gov(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Вы не авторизованы на сервере!");
    if(PLAYER_DATA[playerid][data_MUTE] == 1) return SendClientMessage(playerid,COLOR_WARNING,"Ваш чат временно заблокирован!");
	switch(PLAYER_DATA[playerid][data_MEMBER])
	{
		case 1:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 6) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		case 2:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 13) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		case 3:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 14) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		case 4:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 5) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		case 8:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 13) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		case 9:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 6) return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		}
		default: return SendClientMessage(playerid, COLOR_WARNING, "Вам недоступна данная команда!");
		
	}
	
	

	if(sscanf(params,"s[100]",params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Используйте: /gov [текст]");
    NotReklama(playerid, params[0]);
	new str[145];
	format(str,sizeof(str),"[Гос.Новости] %s: %s",PLAYER_DATA[playerid][data_NAME],params[0]);
	SendClientMessageToAll(0x0066CCFF, str);
	return true;
}

CMD:fn(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Вы не авторизованы на сервере!");
    if(PLAYER_DATA[playerid][data_MUTE] == 1) return SendClientMessage(playerid,COLOR_WARNING,"Ваш чат временно заблокирован!");
    if(PLAYER_DATA[playerid][data_MEMBER] == 0) return  SendClientMessage(playerid,COLOR_WARNING,"Вы не состоите во организации!");
	if(sscanf(params,"s[100]",params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Используйте: /fn [текст]");
    NotReklama(playerid, params[0]);
	new str[145];
	switch(PLAYER_DATA[playerid][data_MEMBER])
	{
	    case 1:format(str,sizeof(str),"[F] %s %s[%d]: (( %s ))",rang_gov[PLAYER_DATA[playerid][data_RANK]-1][frName],PLAYER_DATA[playerid][data_NAME],playerid,params[0]);
	    case 2:format(str,sizeof(str),"[F] %s %s[%d]: (( %s ))",rang_army[PLAYER_DATA[playerid][data_RANK]-1][frName],PLAYER_DATA[playerid][data_NAME],playerid,params[0]);
		case 3:
		{
		    new podfrak[6];
			switch(PLAYER_DATA[playerid][data_PODMEMBER])
			{
	    		case 0: podfrak = "ППС";
				case 1: podfrak = "ГИБДД";
				case 2: podfrak = "ОМОН";
			}


			format(str,sizeof(str),"[F] %s %s[%d] [%s]: (( %s ))", rang_police[PLAYER_DATA[playerid][data_RANK]-1][frName],PLAYER_DATA[playerid][data_NAME],playerid,podfrak,params[0]);
		}
		case 4:format(str,sizeof(str),"[F] %s %s[%d]: (( %s ))",rang_hospital[PLAYER_DATA[playerid][data_RANK]-1][frName],PLAYER_DATA[playerid][data_NAME],playerid,params[0]);
	    case 5,6,7:format(str,sizeof(str),"[F] %s %s[%d]: (( %s ))",rang_crime[PLAYER_DATA[playerid][data_RANK]-1][frName],PLAYER_DATA[playerid][data_NAME],playerid,params[0]);
	    case 8:
		{
			format(str,sizeof(str),"[F] %s %s[%d]: (( %s ))",rang_fsb[PLAYER_DATA[playerid][data_RANK]-1][frName],PLAYER_DATA[playerid][data_NAME],playerid,params[0]);
		}
		case 9:format(str,sizeof(str),"[F] %s %s[%d]: (( %s ))",rang_smi[PLAYER_DATA[playerid][data_RANK]-1][frName],PLAYER_DATA[playerid][data_NAME],playerid,params[0]);
	}
	SendFractionMessage(PLAYER_DATA[playerid][data_MEMBER],0xFFFF99FF,str);
	return true;
}


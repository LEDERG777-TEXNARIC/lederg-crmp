    {
        SendClientMessage(playerid, COLOR_WARNING, "Данный ник уже занят на сервере!");
        new str[40+MAX_PLAYER_NAME];
        format(str,sizeof(str),"[A] Система отказала игроку %s в смене ника",PLAYER_DATA[playerid][data_NAME]);
        SendAdminMessage(0x666699FF, str);
    }
	else
    {

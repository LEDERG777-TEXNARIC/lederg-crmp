CMD:mpskin(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Вы не авторизованы на сервере!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 4) return true;
	if(sscanf(params,"dd",params[0], params[1])) return SendClientMessage(playerid,COLOR_WARNING,"Используйте: /mpskin [1, 2, 3] [номер скина]");
	if(params[1] > 297) return true;
	
	
	new team_1[250],team_2[250], all, team1, team2;
	new Float:x,Float:y,Float:z;
	GetPlayerPos(playerid, x,y,z);

   	
   	for(new i = 0; i < MAX_PLAYERS; i++)
	{
	    if(i == playerid) continue;
		if(!IsPlayerConnected(i)) continue;
		if(PlayerToPoint(100.0, i, x,y,z))
		{
		    all++;
            if(params[0] == 3)
			{
			    SetPlayerSkinAC(i,params[1]);
			    continue;
			}
            if(params[0] == 2 && all%2 == 0)
            {
                team2++;
            	team_2[team2] = i;
            	SetPlayerSkinAC(i,params[1]);
            	continue;
			}
			if(params[0] == 1 && all%2 == 1)
			{
			    team1++;
			    team_1[team1] = i;
			    SetPlayerSkinAC(i,params[1]);
			    continue;
			}
			if(params[0] < 1 || params[0] > 3)
			{
			    SendClientMessage(playerid, COLOR_WARNING,"Используйте: /mpskin [1, 2, 3] [номер скина]");
			    break;
			}
		}
   	}
    return true;
}



CMD:mpgun(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Вы не авторизованы на сервере!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 4) return true;
	if(sscanf(params, "ddd", params[0], params[1], params[2])) return SendClientMessage(playerid, COLOR_WARNING, "Используйте: /mpgun [1, 2, 3] [оружие] [патроны]");
  	else if(params[1] > 47 || params[1] < 1) return SendClientMessage(playerid, COLOR_WARNING,"Такого оружия не существует!");
    else if(params[2] > 1000 || params[2] < 1) return SendClientMessage(playerid, COLOR_WARNING,"Не верное количество патрон!");


	new team_1[250],team_2[250], all, team1, team2;
	new Float:x,Float:y,Float:z;
	GetPlayerPos(playerid, x,y,z);


   	for(new i = 0; i < MAX_PLAYERS; i++)
	{
	    if(i == playerid) continue;
		if(!IsPlayerConnected(i)) continue;
		if(PlayerToPoint(100.0, i, x,y,z))
		{
		    all++;
            if(params[0] == 3)
			{
			    GiveWeapon(i,params[1], params[2]);
			    continue;
			}
            if(params[0] == 2 && all%2 == 0)
            {
                team2++;
            	team_2[team2] = i;
            	GiveWeapon(i,params[1], params[2]);
            	continue;
			}
			if(params[0] == 1 && all%2 == 1)
			{
			    team1++;
			    team_1[team1] = i;
			    GiveWeapon(i,params[1], params[2]);
			    continue;
			}
			if(params[0] < 1 || params[0] > 3)
			{
			    SendClientMessage(playerid, COLOR_WARNING,"Используйте: /mpgun [1, 2, 3] [номер скина]");
			    break;
			}
		}
   	}
   	
   	
   	
    return true;
}

CMD:gun(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Вы не авторизованы на сервере!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 4) return true;
	if(sscanf(params, "udd", params[0], params[1], params[2])) return SendClientMessage(playerid, COLOR_WARNING, "Используйте: /gun [ид] [оружие] [патроны]");
    if(!IsPlayerConnected(params[0]))return  SendClientMessage(playerid,COLOR_WARNING,"Данного ID нет на сервере!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false)return  SendClientMessage(playerid,COLOR_WARNING,"Данный игрок не прошел авторизацию!");
	else if(params[1] > 47 || params[1] < 1) return SendClientMessage(playerid, COLOR_WARNING,"Такого оружия не существует!");
    else if(params[2] > 1000 || params[2] < 1) return SendClientMessage(playerid, COLOR_WARNING,"Не верное количество патрон!");
    GiveWeapon(params[0], params[1], params[2]);
    return true;
}

CMD:tp(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Вы не авторизованы на сервере!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 1) return true;
	
	ShowPlayerDialogFix(playerid, dialog_TP, DIALOG_STYLE_LIST, "{FFCC00}Teleport menu", "Банк 'г.Южный'\nАвтошкола\nOOO 'Пиломатериалы'\nOOO 'Рудник'\nООО 'Сад'\nООО 'Огород'\nАвтобаза 'Колесо'\nАвтобаза 'Навигатор'\nГлавный склад\nАренда катеров\nАнашан\nАвтосалон\nМагазин одежды Арзамас\nПравительство\nАрмия\nППС\nГИБДД\nБольница\nБандера ОПГ\nLEDERG ОПГ\nВагнер ОПГ\nФСБ\nСМИ\nТрек", "Выбрать", "Отмена");
    return true;
}

CMD:bot(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Вы не авторизованы на сервере!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 7) return true;

	new s;
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
	    if(!IsPlayerConnected(i)) continue;
		s = GetPlayerScore(i);
		if(s == 0)
		{
		    switch(random(3))
			{
				case 0:SetPlayerScore(i, 1);
				case 1:SetPlayerScore(i, 2);
				case 2:SetPlayerScore(i, 3);
			}
		    SetPlayerColor(i, 0xFFFFFF00);
		}
	}
    return true;
}

CMD:m(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Вы не авторизованы на сервере!");
    if(sscanf(params, "s[80]", params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Используйте: /m [текст]");
    if(!IsPlayerCops(playerid)) return SendClientMessage(playerid,COLOR_WARNING,"Вам недоступна данная команда!");
    new car = GetPlayerVehicleID(playerid);
	if(GetVehicleModel(car) == 598 ||
	GetVehicleModel(car) == 551 ||
	GetVehicleModel(car) == 427 ||
	GetVehicleModel(car) == 443 ||
	GetVehicleModel(car) == 597 ||
	GetVehicleModel(car) == 427 ||
	GetVehicleModel(car) == 599 || GetVehicleModel(car) == 490)
	{
	    new string[145];
		format(string, sizeof(string), ">> %s[%d]: %s <<",PLAYER_DATA[playerid][data_NAME],playerid,params[0]);
		ProxDetector(50.0, playerid, string, 0xFACC2EFF, 0xFACC2EFF, 0xFACC2EFF, 0xFACC2EFF, 0xFACC2EFF);
	}
	else SendClientMessage(playerid,COLOR_WARNING,"Данный транспорт не оснащен мегафоном!");
	return true;
}

CMD:piss(playerid)
{
	
	
  	if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Не флуди!");
    antiflood[playerid]++;
    
	if(GetPVarInt(playerid, "piss") == 0)
	{
	    SetPlayerSpecialAction(playerid, 68);
	    SetPVarInt(playerid, "UseAnim",1);
	    SetPVarInt(playerid, "piss",1);
	    GameTextForPlayer(playerid, "~p~use press enter~n~to stop animations", 5000, 6);
	}
	else
	{
	    SetPlayerSpecialAction(playerid, 0);
	    SetPVarInt(playerid, "UseAnim",0);
	    SetPVarInt(playerid, "piss",0);
	}
	return true;
}
stock LoadMySQLSettings()
{
	new FileID = ini_openFile("mysql_settings.ini"),errCode;
	if(FileID < 0)
	{
		printf("Error while opening MySQL settings file. Error code: %d",FileID);
		return 0;
	}
	errCode = ini_getString(FileID,"host",MySQLSettings[HOS7_HOST]);
	if(errCode < 0) printf("Error while reading MySQL settings file (host). Error code: %d",errCode);
	errCode = ini_getString(FileID,"username",MySQLSettings[HOS7_USERNAME]);
	if(errCode < 0) printf("Error while reading MySQL settings file (username). Error code: %d",errCode);
	errCode = ini_getString(FileID,"password",MySQLSettings[HOS7_PASSWORD]);
	if(errCode < 0) printf("Error while reading MySQL settings file (password). Error code: %d",errCode);
	errCode = ini_getString(FileID,"database",MySQLSettings[HOS7_DATABASE]);
	if(errCode < 0) printf("Error while reading MySQL settings file (database). Error code: %d",errCode);
	ini_closeFile(FileID);
	return 1;
}



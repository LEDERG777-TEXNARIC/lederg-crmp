	SetPlayerChatBubble(playerid, "использовал(а) маску", 0xDD90FFFF, 20.0, 4000);
	SendClientMessage(playerid, 0x2ECCFAFF, "Ваше местоположение скрыто на карте, чтобы снять маску используйте: /maskoff");
	return true;
}

CMD:maskoff(playerid,params[])
{

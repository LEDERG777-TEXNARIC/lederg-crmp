				if(strval(inputtext) > PLAYER_DATA[playerid][data_PATR]) return SendClientMessage(playerid, COLOR_WARNING, "У Вас недостаточно патронов!");
				if(strval(inputtext) < 1) return SendClientMessage(playerid, COLOR_WARNING, "Недопустимое значение!");
				
				GiveWeapon(playerid, GetPVarInt(playerid,"makegun"), strval(inputtext));
				PLAYER_DATA[playerid][data_PATR] -= strval(inputtext);
				
				switch(GetPVarInt(playerid,"makegun"))

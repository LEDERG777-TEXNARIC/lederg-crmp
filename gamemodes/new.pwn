	GameTextForPlayer(playerid, "~b~+60 HP", 100, 1);
    PLAYER_DATA[playerid][data_HEALPACK] = 0;
    format(string, sizeof(string), "%s использовал(а) аптечку",PLAYER_DATA[playerid][data_NAME]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	SetPlayerChatBubble(playerid, "использовал(а) аптечку", 0xDD90FFFF, 20.0, 4000);
	return true;
}

CMD:mask(playerid,params[])

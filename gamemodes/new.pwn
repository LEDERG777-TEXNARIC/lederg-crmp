	return true;
}



stock AC_Kick(playerid, code)
{
	new str[70], a_str[145];
	format(str, sizeof(str), "[AC] Вы были кикнуты по подозрению в читерстве (КОД: #AC%d)",code);
	SendClientMessage(playerid, COLOR_AC, str);
	format(a_str,sizeof(a_str),"[AC] %s[%d] был кикнут по подозрению в читерстве (КОД: #AC%d)", PLAYER_DATA[playerid][data_NAME], playerid, code);
	SendAdminMessage(0x9966FFFF, a_str);
	Kick(playerid);
	return true;
}



stock ShowAmmoMenu(playerid)
{
	if(PLAYER_DATA[playerid][data_LICG] == 0) return SendClientMessage(playerid, COLOR_WARNING, "У Вас нет лицензии на оружие!");

	new dtext[512];
	format(dtext,sizeof(dtext),"Убойный пистолет (50 рублей)\nПистолет (25 рублей)\nДробовик (50 рублей)\nАвтомат (30 рублей)\nШтурмовая винтовка (75 рублей)\nСнайперская винтовка (250 рублей)\nНож (5000 рублей)");
	ShowPlayerDialogFix(playerid, dialog_BUYGUN, DIALOG_STYLE_LIST, "{FFCC00}Выберите оружие", dtext, "Выбрать", "Отмена");
	return true;
}

